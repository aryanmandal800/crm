# ── Required ─────────────────────────────────────────────
DATABASE_URL="postgresql://fivopay:CHANGE_ME@localhost:5432/fivopay_crm"
# 32+ random characters:  openssl rand -base64 48
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
APP_URL="https://crm.fivopay.com"
NODE_ENV=production
PORT=3000

# ── First-run seed (initial accounts; temporary passwords are printed once) ──
SEED_FOUNDER_EMAIL="amin@fivopay.com"
# SEED_FOUNDER_PASSWORD=""        # optional; random if blank. Must be changed at first login anyway.
SEED_TECH_EMAIL="aryan@fivopay.com"
SEED_SALES_EMAIL="priya@fivopay.com"
SEED_DEMO=false                   # true = fictitious [DEMO] records for UI review (npm run db:purge-demo removes them)

# ── Optional ─────────────────────────────────────────────
SESSION_HOURS=12
DB_POOL_MAX=10
# COOKIE_SECURE=false             # only if serving over plain HTTP internally (not recommended)
# ANTHROPIC_API_KEY=""            # enables LLM insights when Settings → AI provider = ANTHROPIC
# SMTP_HOST="" SMTP_PORT=587 SMTP_SECURE=false SMTP_USER="" SMTP_PASS="" SMTP_FROM="Fivopay CRM <no-reply@fivopay.com>"
# PG_DUMP_PATH="/usr/bin/pg_dump" # if pg_dump is not on PATH
# WORKER_INTERVAL_MS=30000
